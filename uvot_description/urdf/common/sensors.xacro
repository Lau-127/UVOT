<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="uvot_sensors" params="exploded:=false">
    <xacro:property name="exploded_sensors" value="${0.12 if exploded else 0.0}"/>
    <xacro:property name="exploded_camera_box" value="${0.022 if exploded else 0.0}"/>

    <joint name="lidar_joint" type="fixed">
      <parent link="$(arg robot_ns)/base_link"/>
      <child link="$(arg robot_ns)/base_lidar"/>
      <origin xyz="0.0 0.0 ${0.095 + exploded_sensors}" rpy="0 0 ${pi}"/>
    </joint>

    <link name="$(arg robot_ns)/base_lidar">
      <visual>
        <origin xyz="0 0 0.02086" rpy="${-pi/2} 0 0"/>
        <geometry>
          <mesh filename="${mesh_prefix}/rplidar/rplidar_s2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.05"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>

        <mass value="0.190"/>

        <inertia
          ixx="${0.190 * (3*0.035*0.035 + 0.050*0.050) / 12.0}"
          ixy="0"
          ixz="0"
          iyy="${0.190 * (3*0.035*0.035 + 0.050*0.050) / 12.0}"
          iyz="0"
          izz="${0.190 * 0.035*0.035 / 2.0}"/>
      </inertial>
    </link>

    <joint name="scan_joint" type="fixed">
      <parent link="$(arg robot_ns)/base_lidar"/>
      <child link="$(arg robot_ns)/base_scan"/>
      <origin xyz="0.0 0.0 0.017" rpy="0 0 0"/>
    </joint>

    <link name="$(arg robot_ns)/base_scan"/>

    <!-- Camera support box -->
    <joint name="camera_box_joint" type="fixed">
      <parent link="$(arg robot_ns)/base_link"/>
      <child link="$(arg robot_ns)/camera_box_link"/>
      <origin xyz="${0.1055 + exploded_camera_box} 0.0 ${0.03 + exploded_camera_box}" rpy="0 0 0"/>
    </joint>

    <link name="$(arg robot_ns)/camera_box_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.014 0.060 0.050"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.014 0.060 0.050"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <!-- Mass of complete camera assembly -->
        <mass value="0.041"/>

        <inertia
          ixx="${0.041 * (0.060*0.060 + 0.050*0.050) / 12.0}"
          ixy="0"
          ixz="0"
          iyy="${0.041 * (0.014*0.014 + 0.050*0.050) / 12.0}"
          iyz="0"
          izz="${0.041 * (0.014*0.014 + 0.060*0.060) / 12.0}"/>
      </inertial>
    </link>

    <!-- Camera lens -->
    <joint name="camera_lens_joint" type="fixed">
      <parent link="$(arg robot_ns)/camera_box_link"/>
      <child link="$(arg robot_ns)/camera_lens_link"/>
      <origin xyz="0.014 0.0 0.0" rpy="0 ${pi/2} 0"/>
    </joint>

    <link name="$(arg robot_ns)/camera_lens_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.014" radius="0.008"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.014" radius="0.008"/>
        </geometry>
      </collision>
    </link>

    <!-- Camera frame -->
    <joint name="camera_joint" type="fixed">
      <parent link="$(arg robot_ns)/camera_box_link"/>
      <child link="$(arg robot_ns)/camera_rgb_optical_frame"/>
      <origin xyz="0.021 0.0 0.0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="$(arg robot_ns)/camera_rgb_optical_frame"/>
  </xacro:macro>

</robot>

