<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="uvot_ros2_control" params="robot_type">

    <ros2_control name="GazeboSimSystem" type="system">

      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <!-- Ruedas traseras: existen en las tres configuraciones -->
      <joint name="wheel1_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wheel2_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Ruedas delanteras: solo omni y skid -->
      <xacro:unless value="${robot_type == 'diff'}">

        <joint name="wheel3_joint">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <joint name="wheel4_joint">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

      </xacro:unless>

    </ros2_control>

  </xacro:macro>

</robot>
